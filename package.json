{
  "name": "n8n-nodes-lmstudio-reneworks",
  "version": "0.3.0",
  "description": "Connect n8n to LM Studio with MCP server support, designed for AI Agents. Multi-mode: native REST, OpenAI Chat Completions and Responses.",
  "keywords": [
    "n8n-community-node-package",
    "mcp",
    "lmstudio",
    "lm-studio",
    "ai-agents",
    "n8n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reneworks/n8n-lmstudio-reneworks.git"
  },
  "homepage": "https://github.com/Reneworks/n8n-lmstudio-reneworks#readme",
  "bugs": {
    "url": "https://github.com/Reneworks/n8n-lmstudio-reneworks/issues"
  },
  "author": {
    "name": "Reneworks",
    "email": "contacto@reneworks.mx",
    "url": "https://reneworks.mx"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && cp nodes/McpChatModel/*.svg dist/nodes/McpChatModel/ && echo \"build: OK\"",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"nodes/**/*.ts\" \"credentials/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/McpChatModel/McpChatModel.node.js"
    ],
    "credentials": [
      "dist/credentials/LmStudioApi.credentials.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.0.0",
    "prettier": "^2.0.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://reneworks.mx"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "axios": "^1.0.0"
  },
  "overrides": {
    "form-data": "^4.0.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}