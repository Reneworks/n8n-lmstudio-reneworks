{
  "name": "n8n-nodes-lmstudio-reneworks",
  "version": "0.2.3",
  "description": "Connect n8n to LM Studio with MCP server support, designed for AI Agents.",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://github.com/your-repo/n8n-nodes-mcp-chat",
