    "n8n-workflow": "^1.0.0",
    "prettier": "^2.0.5",
    "tslint": "^6.1.2",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@langchain/core": "^0.1.5",
    "axios": "^1.0.0"
  },
  "overrides": {
    "form-data": "^4.0.5"
  }
